# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=<mongoDB_connection_string>

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<min_32_char_random_hex>
JWT_REFRESH_SECRET=<min_32_char_random_hex_different_from_above>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed client origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Admin API ─────────────────────────────────────────────────────────────────
# Required in x-admin-key header to access /api/words/* endpoints
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=<min_32_char_random_hex>

# ── AI Word Pipeline ──────────────────────────────────────────────────────────
GOOGLE_AI_API_KEY=<gemini_api_key>
WORD_REFILL_THRESHOLD=30
WORD_FETCH_COUNT=500

# ── API Docs (Swagger) ────────────────────────────────────────────────────────
DOCS_USER=admin
DOCS_PASSWORD=<your_docs_password>
